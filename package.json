{
  "name": "effect-formula",
  "version": "0.1.0",
  "private": true,
  "description": "Effect-native spreadsheet-style formula engine",
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "COMPATIBILITY.md",
    "conformance"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "conformance": "vitest run test/conformance.test.ts test/openformula-cases.test.ts test/production-formula.test.ts",
    "conformance:production": "PRODUCTION_PARITY_STRICT=1 vitest run test/production-formula.test.ts",
    "conformance:full": "pnpm build && node scripts/conformance-full.mjs --group small",
    "conformance:report": "pnpm build && node scripts/conformance-full.mjs --group small --report",
    "format": "oxfmt src test scripts package.json .oxfmtrc.json .oxlintrc.json",
    "lint": "oxlint --deny-warnings src test scripts",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm build",
    "format:check": "oxfmt --check src test scripts package.json .oxfmtrc.json .oxlintrc.json"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "effect": "3.22.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "effect": "^3.22.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0"
}
